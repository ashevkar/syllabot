# Copy to `.env` (`make env`). Values here suit running the API on your machine
# against the compose Postgres/Redis; docker compose overrides the hostnames for
# containers. Variables marked (Mx-yy) are read from that task onwards.

# --- App ---
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000   # comma-separated
SIGNUP_MODE=open                 # open | closed (M2-01)
TRUSTED_PROXY_HOPS=0             # 1 behind a single reverse proxy (M4-08)

# --- Database / Redis ---
POSTGRES_PORT=5433               # host port for the compose Postgres (5432 is often taken)
DATABASE_URL=postgresql+asyncpg://syllabot:syllabot@localhost:5433/syllabot
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1   # (M2-05)

# --- Auth (M2-01) ---
JWT_SECRET=change-me-64-random-bytes
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14
CLIENT_HASH_SECRET=change-me     # HMAC key for chat_sessions.client_hash (M1-11)

# --- Storage (M1-08) ---
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_DIR=./data/uploads
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=20
MAX_SOURCES_PER_BOT=20

# --- LLM providers (M1-04; model strings are provider:model_id) ---
# Gemini free tier: Google may use prompts/responses to improve its products.
# Use synthetic or public syllabi only (PLAN.md R6).
GEMINI_API_KEY=                                 # free key from https://aistudio.google.com/apikey
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_CHAT_MODEL=gemini:gemini-3.5-flash-lite # final value set by the M1-15 ADR
FALLBACK_CHAT_MODEL=ollama:qwen3:8b             # tried on Gemini quota errors; empty = off
EXTRACTION_MODEL=                               # empty = DEFAULT_CHAT_MODEL
JUDGE_MODEL=gemini:gemini-3.6-flash             # one tier up from the chat model

# --- Embeddings (M1-05; dimension must match the DB column) ---
EMBEDDING_PROVIDER=gemini        # gemini | local
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536               # 384 for BAAI/bge-small-en-v1.5

# --- Limits / retention / cost ---
RATE_LIMIT_DEFAULT_PER_MIN=20    # (M4-08)
CHAT_RETENTION_DAYS=180          # (M4-11)
DAILY_LLM_BUDGET_USD=5           # (M5-06)

# --- Observability (M5-06) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
