    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
